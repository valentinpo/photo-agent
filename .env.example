# Копия для локальной настройки: скопируйте этот файл в «.env» и заполните значения.
# .env НЕ должен попадать в git (он уже в .gitignore).

# API-ключ сервисного аккаунта Yandex Cloud (строка вида AQVN...)
YANDEX_API_KEY=

# Идентификатор каталога Yandex Cloud (строка вида b1g...)
YANDEX_FOLDER_ID=

# Мультимодальная vision-модель Яндекс AI Studio
YANDEX_MODEL=qwen3.6-35b-a3b